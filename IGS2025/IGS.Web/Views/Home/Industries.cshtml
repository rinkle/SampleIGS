@using Globalsetting
@inject Globalsetting.GlobalEnvironmentSetting globalEnvironmentSetting
@model IGS.Models.ViewModels.IndustryViewModel
@using IGS.Models.KeyLessModels;
@{
    string baseUrl = globalEnvironmentSetting.AppSettingValue("AppSettings:baseurl");
    int Counter = 1;
}

@if (Model?.Industry != null)
{
    <div class="services">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="f31">@Model?.Industry?.IndustryHeading</h3>
                    <p class="f18">@Model?.Industry?.IndustryDescription</p>
                    @if (Model!.IndustryCategory != null && Model!.IndustryCategory.Count > 0)
                    {
                        <div class="accordion" id="accordionServices">
                            @foreach (var item in Model!.IndustryCategory)
                            {
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="accordionServices-heading@(Counter)">
                                        <button class="accordion-button collapsed f20" type="button" data-bs-toggle="collapse" data-bs-target="#accordionServices-collapse@(Counter)" aria-expanded="true" aria-controls="accordionServices-collapse@(Counter)">@item.IndustryName</button>
                                    </h2>
                                    <div id="accordionServices-collapse@(Counter)" class="accordion-collapse collapse" aria-labelledby="accordionServices-heading@(Counter)">
                                        <div class="accordion-body">
                                            @if (!string.IsNullOrEmpty(item.IndustryDescription))
                                            {
                                                @Html.Raw(item.IndustryDescription.Replace("<h5>", "<h5 class='title'>"))
                                            }
                                        </div>
                                    </div>
                                </div>
                                Counter++;
                            }

                        </div>
                    }

                </div>
            </div>
        </div>
    </div>

    <div class="explore pt-0">
        <div class="container">
            <div class="row mb-4">
                <div class="col-lg-8">
                    <h3 class="f31">@Model?.Industry?.InsightHeading</h3>
                </div>

                <div class="col-lg-4">
                    <div class="d-flex flex-column">
                        <a href='@(baseUrl + "insights")' class="view-more f16 ms-auto">View All</a>
                    </div>
                </div>
            </div>

            <div class="row" id="insightContainer">
                <p>Loading insights...</p>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        $(document).ready(function () {
            const pageIds = "4";
            const categoryIds="";
            const orderBy="DisplayOrder";
            $.get("@Url.Action("LoadInsightSection", "Common")", { categoryIds, pageIds, orderBy })
                    .done(function (result) {
                    $("#insightContainer").html(result);
                })
                .fail(function () {
                     $("#insightContainer").html("<p>Error loading insights.</p>");
             });
        });
    </script>
}