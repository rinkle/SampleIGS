@using Globalsetting
@inject Globalsetting.GlobalEnvironmentSetting GlobalEnvironmentSetting
@model IGS.Models.ViewModels.HomeViewModel

@{
    string baseUrl = GlobalEnvironmentSetting.AppSettingValue("AppSettings:baseurl");
}

@if (Model?.Home != null)
{
    <div class="home">
        <div id="homeCarousel" class="carousel carousel-fade slide" data-bs-ride="carousel" data-bs-interval="8000" data-bs-pause="false">
            <div class="carousel-inner">
                @if (Model?.Carousel?.Count > 0)
                {
                    int Counter = 1;
                    foreach (var item in Model.Carousel)
                    {
                        <div class='carousel-item @(Counter == 1 ? "active" : "")'>
                            <div class="container">
                                <div class="row justify-content-center">
                                    <div class="col-12">
                                        <div class="content d-flex flex-column">
                                            <h1 class="f55">@Html.Raw(item?.Heading)</h1>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        Counter = Counter + 1;
                    }
                    {
                        Counter = 1;
                    }
                    foreach (var item in Model.Carousel)
                    {
                        if (Counter == 1)
                        {
                            <style>
                                .home .carousel-item {
                                    background: linear-gradient(rgba(0,0,0,.2),rgba(0,0,0,.2)), url('@(baseUrl + DbImagePath.HomeCarousel + item.UploadedData)') center no-repeat;
                                    background-size: cover !important;
                                }
                            </style>
                        }
                        else
                        {
                            <style>
                                .home .carousel-item:nth-child( @Counter ) {
                                    background: linear-gradient(rgba(0,0,0,.2),rgba(0,0,0,.2)), url('@(baseUrl + DbImagePath.HomeCarousel + item.UploadedData)') center bottom no-repeat;
                                }
                            </style>
                        }
                        Counter = Counter + 1;
                    }
                }
            </div>
        </div>
    </div>
    @if (Model != null && Model.AtAGlance != null)
    {
        <div class="snapshot">
            <div class="container">
                <div class="row">
                    @foreach (var item in Model.AtAGlance)
                    {
                        <div class="col-md-4">
                            <div class="content">
                                @Html.Raw(item.Description)
                                <h5 class="details f20">@item.Heading</h5>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="partner">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="f31">@Model?.Home.TransactionsGrowthHeading</h3>
                    <h5 class="f18 mb-4">@Model?.Home.TransactionsGrowthDescription</h5>
                </div>
            </div>
            @if (Model?.TransactionsandGrowth != null)
            {
                <div class="row gx-3">
                    @foreach (var item in Model.TransactionsandGrowth)
                    {
                        <div class="col-sm-4 gx-3">
                            <div class="content">
                                <h5 class="title f32">@item.Heading</h5>
                                <p class="f22">@item.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="core">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="f31">@Model?.Home?.CoreAreasHeading</h3>
                    <p class="f18">@Model?.Home?.CoreAreaDescription</p>
                </div>
            </div>
            @if (Model?.CoreAreasoFocus != null)
            {
                <div class="main">
                    <div class="row">
                        @foreach (var item in Model.CoreAreasoFocus)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="content">
                                    <div class="img-container">
                                        <img src='@(baseUrl + DbImagePath.HomeImage + item.UploadedData)' alt="@item.Heading" title="@item.Heading" class="img-contain" asp-append-version="true">
                                    </div>
                                    <h5 class="title f24">@item.Heading</h5>
                                    <h5 class="desc">@item.Description</h5>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            <style>
                .core .main::before {
                    position: absolute;
                    top: 1.25rem;
                    left: 0;
                    display: block;
                    width: 100%;
                    height: 100%;
                    content: '';
                    background: url('@(baseUrl + "images/art/core-areas-ark.png")') center top no-repeat;
                    background-size: 100%;
                }
            </style>
        </div>
    </div>

    <div class="recent-projects p-0">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <h3 class="f31">@Model?.Home?.RecentProjectsHeading</h3>
                    <p class="f18 pb-lg-3 mb-4">@Model?.Home?.RecentProjectsDescription.</p>
                </div>

                <div class="col-lg-4">
                    <div class="d-flex flex-column">
                        <a href='@(baseUrl + "experience")' class="view-more f16 ms-auto">View All</a>
                    </div>
                </div>
            </div>

            <div class="row" id="experienceContainer">
                <p>Loading recent projects...</p>
            </div>
        </div>
    </div>

    <div class="latest-insights">
        <div class="container">
            <div class="row">
                <div class="col-lg-6">
                    <h3 class="f31">@Model?.Home?.InsightTitle</h3>
                </div>

                <div class="col-lg-6">
                    <div class="d-flex flex-column">
                        <a href='@(baseUrl + "insights")' class="view-more f16 ms-auto">View All</a>
                    </div>
                </div>

                <div class="co-12">
                    <hr>
                </div>

                <div class="col-lg-6">
                    <h4 class="f31">@Model?.Home?.InsightHeading</h4>

                    <p class="f18">@Html.Raw(@Model?.Home?.InsightDescription)</p>
                    @if (!string.IsNullOrEmpty(Model?.Home?.InsightPdfReport))
                    {
                        <a href='@(baseUrl + DbImagePath.HomeImage + Model.Home.InsightPdfReport)' target="_blank" class="view-more mt-3">Download Full Report</a>
                    }

                </div>

                <div class="col-lg-6">
                    <div class="img-container">
                        <img src='@(baseUrl + DbImagePath.HomeImage + Model?.Home?.InsightImage)' alt="@Model?.Home?.InsightHeading" class="img-cover" asp-append-version="true">
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            const pageIds = "1"; // adjust dynamically as needed

            $.get("@Url.Action("LoadExperienceSection", "Home")", { pageIds })
                .done(function (result) {
                    $("#experienceContainer").html(result);
                })
                .fail(function () {
                    $("#experienceContainer").html("<p>Error loading experiences.</p>");
                });
        });
    </script>
}