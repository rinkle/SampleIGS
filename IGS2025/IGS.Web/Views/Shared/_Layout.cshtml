@inject Globalsetting.GlobalEnvironmentSetting globalEnvironmentSetting
@inject Globalsetting.GlobalCookies Cookies
@using System.Text.Json
@using Globalsetting
@{
    string baseUrl = globalEnvironmentSetting.AppSettingValue("AppSettings:baseurl");
    string pageName = !string.IsNullOrEmpty(ViewBag.pageName) ? ViewBag.pageName : "";
    string canonicalUrl = !string.IsNullOrEmpty(ViewBag.canonical) ? ViewBag.canonical : "";
    string appName = globalEnvironmentSetting.AppSettingValue("AppSettings:AppName");
    string liveUrl = globalEnvironmentSetting.AppSettingValue("AppSettings:liveurl");
    var common = ViewBag.CommonService as IGS.Models.ViewModels.CommonHeaderFooterModel;
    string defaultPageTitle = globalEnvironmentSetting.AppSettingValue("AppSettings:PageTitle");
    string defaultOGTitle = globalEnvironmentSetting.AppSettingValue("AppSettings:DefaultOGTitle");
    string defaultOGDescription = globalEnvironmentSetting.AppSettingValue("AppSettings:DefaultOGDescription");
    string defaultOGImage = globalEnvironmentSetting.AppSettingValue("AppSettings:DefaultOGimage");
    string defaultMetaDescription = globalEnvironmentSetting.AppSettingValue("AppSettings:DefaultMetaDescription");
    string HeaderId = string.Empty;
    HeaderId = "#" + @common?.HeaderInfo?.BodyPageId;

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content='@(common?.HeaderInfo?.MetaDescription ?? defaultMetaDescription)' />
    <meta property="og:title" content='@(common?.HeaderInfo?.OGTitle ?? defaultOGTitle)' />
    <meta property="og:description" content='@(common?.HeaderInfo?.OGDescription ?? defaultOGDescription)' />
    <meta property="og:image" content='@(baseUrl + DbImagePath.Image + common?.HeaderInfo?.OGImage ?? defaultOGImage)' />
    <link rel="apple-touch-icon" sizes="180x180" href='@(baseUrl + "images/favicon/apple-touch-icon.png")' />
    <link rel="icon" type="image/png" sizes="32x32" href='@(baseUrl + "images/favicon/favicon-32x32.png")' />
    <link rel="icon" type="image/png" sizes="16x16" href='@(baseUrl + "images/favicon/favicon-16x16.png")' />


    @if (ViewBag.pageName == PageName.Home && !string.IsNullOrEmpty(liveUrl))
    {
        <link rel="canonical" href="@liveUrl" />
        <link rel="alternate" href="@liveUrl" hreflang="en-US" />
    }
    else
    {
        if (!string.IsNullOrEmpty(canonicalUrl))
        {
            <link rel="canonical" href='@(baseUrl + canonicalUrl)' />
            <link rel="alternate" href='@(baseUrl + canonicalUrl)' hreflang="en-US" />
        }
    }
    <title>
        @(common?.HeaderInfo != null && !string.IsNullOrEmpty(common.HeaderInfo.PageTitle)
                ? common.HeaderInfo.PageTitle + (ViewBag.AdditionalTitle != null ? " | " + ViewBag.AdditionalTitle : "")
                : defaultPageTitle)
    </title>

    @if (liveUrl.Contains("igsinsights.com"))
    {
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-JWGCT5RDN7"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-JWGCT5RDN7');
        </script>
    }

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous" />
    <link rel="stylesheet" type="text/css" href='@(baseUrl + "css/style.css")' asp-append-version="true" />

</head>
<body id='@(common?.HeaderInfo?.BodyPageId ?? "")'>
    <wrapper class="d-flex flex-column">
        #<!-- #navbar -->
        <nav class="navbar navbar-expand-lg fixed-top trans">
            <div class="container">
                <a class="navbar-brand ms-0" href="@baseUrl">
                    <img src='@(baseUrl + "images/IGS-logo.svg")' alt="IGS logo" class="img-fluid trans" asp-append-version="true" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#myNavbar" aria-controls="myNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <svg xmlns="http://www.w3.org/2000/svg" width="42" height="42" viewBox="0 0 42 42" fill="none">
                        <path d="M7 8.75H35" stroke="#fff" stroke-width="2.625" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M7 21H35" stroke="#fff" stroke-width="2.625" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M7 33.25H35" stroke="#fff" stroke-width="2.625" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <div class="collapse navbar-collapse" id="myNavbar">
                    <div class="navbar-nav position-relative w-100">
                        <a href='@(baseUrl + "transaction-services")' class='nav-link ms-lg-auto @(ViewBag.pageName == PageName.TransactionServices?"active":"")'>Transaction Services</a>
                        <a href='@(baseUrl + "portfolio-services")' class='nav-link @(ViewBag.pageName == PageName.PortfolioServices ? "active" : "")'>Portfolio Services</a>
                        <a href='@(baseUrl + "industries")' class='nav-link @(ViewBag.pageName == PageName.Industries ? "active" : "")'>Industries</a>
                        <a href='@(baseUrl + "experience")' class='nav-link @(ViewBag.pageName == PageName.Experience ? "active" : "")'>Experience</a>
                        <a href='@(baseUrl + "insights")' class='nav-link @(ViewBag.pageName == PageName.Insights ? "active" : "")'>Insights</a>
                        <a href='@(baseUrl + "team")' class='nav-link @(ViewBag.pageName == PageName.Team ? "active" : "")'>Team</a>
                        @if (!string.IsNullOrEmpty(common?.OtherContact?.CareersUrl))
                        {
                            <a href="@common?.OtherContact.CareersUrl" target="_blank" class="nav-link">Careers</a>
                        }
                        @if (!string.IsNullOrEmpty(common?.ContactInfo?.Email))
                        {
                            <a href="mailto:@common?.ContactInfo?.Email" class="nav-link nav-contact me-lg-0">Contact Us</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
        <!-- #endregion -->
        <!-- #region Header -->
        @if (ViewBag.pageName == PageName.TransactionServices || ViewBag.pageName == PageName.PortfolioServices || ViewBag.pageName == PageName.Industries || ViewBag.pageName == PageName.Experience)
        {
            <header>
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <div class="content">
                                <h1 class="f56">@common?.HeaderInfo?.HeaderCaption</h1>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <style>

                @HeaderId header {
                    background: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.1) 44.98%, rgba(0, 0, 0, 0.00) 100%), url('@(baseUrl + DbImagePath.pageHeader + common?.HeaderInfo?.HeaderImage)') center no-repeat;
                }

            </style>
        }

        <!-- #endregion -->
        @RenderBody()


        <!-- #region subscribe newsletter -->
        <div class="subscribe mt-auto">
            @await Component.InvokeAsync("NewsletterSection")
        </div>
        <!-- #endregion -->

        <!-- #Footer -->
        <footer>
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-xl-5">
                        <a href="@baseUrl" class="nav-logo">
                            <img src='@(baseUrl + "images/IGS-logo.svg")' alt="IGS logo" class="img-fluid" asp-append-version="true" />
                        </a>

                        <nav class="nav nav-social f16">
                            @if (!string.IsNullOrEmpty(common?.ContactInfo?.Email))
                            {
                                <a href="mailto:@common?.ContactInfo?.Email" class="nav-item"><img src='@(baseUrl + "images/icons/footer-mail.svg")' alt="mail icon" class="img-contain"></a>
                            }
                            @if (!string.IsNullOrEmpty(common?.ContactInfo?.LinkedInUrl))
                            {
                                <a href="@common?.ContactInfo?.LinkedInUrl" target="_blank" class="nav-item"><img src='@(baseUrl + "images/icons/footer-linkedin.svg")' alt="linkedin icon" class="img-contain" asp-append-version="true"></a>
                            }
                        </nav>
                    </div>

                    <div class="col-lg-4 col-xl-3">
                        <h5 class="f18">Quick Links</h5>

                        <div class="d-flex flex-column flex-lg-row justify-content-between">
                            <nav class="nav flex-column f16">
                                <a href='@(baseUrl + "transaction-services")' class="nav-item me-lg-auto">Transaction Services</a>
                                <a href='@(baseUrl + "ortfolio-services")' class="nav-item">Portfolio Services</a>
                                <a href='@(baseUrl + "ndustries")' class="nav-item">Industries</a>
                                <a href='@(baseUrl + "experience")' class="nav-item me-lg-auto">Experience</a>
                            </nav>

                            <nav class="nav flex-column f16">
                                <a href='@(baseUrl + "insights")' class="nav-item">Insights</a>
                                <a href='@(baseUrl + "team")' class="nav-item">Team</a>
                                @if (!string.IsNullOrEmpty(common?.OtherContact?.CareersUrl))
                                {
                                    <a href="@common?.OtherContact.CareersUrl" target="_blank" class="nav-item">Careers</a>
                                }
                            </nav>
                        </div>
                    </div>

                    <div class="col-lg-2 offset-lg-1 offset-xl-2">
                        <nav class="nav flex-column">
                            <h5>Contact Info</h5>

                            <address>
                                @if (!string.IsNullOrEmpty(common?.ContactInfo?.Phone))
                                {
                                    <a href="tel:@common?.ContactInfo?.Phone">@common?.ContactInfo?.Phone</a>
                                }
                                <img src='@(baseUrl + "images/icons/footer-phone.svg")' alt="phone icon" class="img-contain">
                            </address>

                            <address>
                                @common?.ContactInfo?.Street_Address1, <br>
                                @common?.ContactInfo?.Street_Address2 <br>
                                @common?.ContactInfo?.City, @common?.ContactInfo?.State
                                <img src='@(baseUrl + "images/icons/footer-location.svg")' alt="location icon" class="img-contain" asp-append-version="true">
                            </address>
                        </nav>
                    </div>

                    <div class="col-12">
                        <p>
                            © @DateTime.Now.Year
                            All Rights Reserved - Investor Group Services
                            <span class="float-md-end"><a href="https://www.privateequitysites.com" target="_blank">CleverDesign</a></span>
                            <span class="float-md-end hide-footer-links"><a href="javascript:void(0);">Privacy Policy</a></span>
                            <span class="float-md-end dot"></span>
                            <span class="float-md-end hide-footer-links"><a href="javascript:void(0);">Terms & Conditions</a></span>
                        </p>
                    </div>
                </div>
            </div>
        </footer>
        <!-- #endregion -->
    </wrapper>

    <!-- <script></script> -->
    <!-- Bootstrap core JavaScript Placed at the end of the document so the pages load faster -->
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <script src="https://kit.fontawesome.com/77ad13de6a.js" crossorigin="anonymous"></script>
    <script type="text/javascript" src='@(baseUrl + "js/count.js")' asp-append-version="true"></script>
    <script type="text/javascript" src='@(baseUrl + "js/scroll.js")' asp-append-version="true"></script>
    <script type="text/javascript" src='@(baseUrl + "js/script.js")' asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- #endregion -->
</body>
</html>
