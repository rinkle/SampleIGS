@using Globalsetting
@inject Globalsetting.GlobalEnvironmentSetting GlobalEnvironmentSetting
@model IGS.Models.ViewModels.TeamViewModel

@{
    string baseUrl = GlobalEnvironmentSetting.AppSettingValue("AppSettings:baseurl");
    string catId = Convert.ToString(ViewBag.ActiveCategory);
    string onloadBio = string.Empty;
    if (!string.IsNullOrEmpty(ViewBag.teamUrl))
    {
        onloadBio = ViewBag.teamUrl;
    }
}

@if (Model?.TeamList != null && Model?.TeamCategories != null)
{
    <input type="hidden" class="hdnCategory" value="@catId" />

    <div class="team">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12">
                    <nav class="nav nav-filter flex-column flex-sm-row justify-content-center">
                        @if (Model?.TeamCategories != null && Model.TeamCategories.Any())
                        {
                            foreach (var cat in Model.TeamCategories)
                            {
                                <a href="javascript:void(0)"
                                   class='nav-item @(cat.Id.ToString() == catId ? "active" : "")'
                                   data-categoryid="@cat.Id">@cat.Category</a>
                            }
                        }
                        <a href="javascript:void(0)" class='nav-item @(string.IsNullOrEmpty(catId) ? "active" : "")'>All</a>
                    </nav>
                </div>
            </div>

            <div class="row" id="teamContainer">
            </div>
        </div>
    </div>

    <!-- Team Modal -->
    <div class="modal fade" id="teamModal" tabindex="-1" aria-labelledby="teamModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content border-0 rounded-0">
                <div class="modal-body teamBio">
                  
                </div>
            </div>
        </div>
    </div>

   

}
@section Scripts {
    <script>
        $(document).ready(function () {

         

            // ✅ Auto open team bio if passed from server
            if ('@onloadBio' != '') {
                var url = '#' + '@onloadBio';
                $(url).click();
            }

            // ✅ Load all team members on initial page load
            loadTeamMembers($('.hdnCategory').val());

            // ✅ On category click
            $(".nav-filter .nav-item").on("click", function () {
                $(".nav-filter .nav-item").removeClass("active");
                $(this).addClass("active");

                const categoryIds = $(this).data("categoryid") || "";
                $('.hdnCategory').val(categoryIds);

                // Fade out current team section before loading new data
                $("#teamContainer").fadeOut(250, function () {
                    loadTeamMembers(categoryIds);
                });
            });

            // ✅ AJAX function to load team members smoothly
            function loadTeamMembers(categoryIds) {
                categoryIds = categoryIds || "";
                $.get("@Url.Action("LoadTeamSection", "Common")", { categoryIds })
                    .done(function (result) {
                        $("#teamContainer").hide().html(result).fadeIn(400);

                        if ('@onloadBio' != '') {
                            var url = '#' + '@onloadBio';
                            $(url).click();
                        }
                    })
                    .fail(function () {
                        $("#teamContainer").fadeOut("slow", function () {
                            $(this).html("<p>Error loading team members.</p>").fadeIn("slow");
                        });
                    });
            }
        });

        // ✅ Open modal with bio content (smooth fade)
        function openTeamModel(teamId, bioUrl) {
            $(".teamBio").html("<p>loading...</p>");
            $.get("@Url.Action("LoadTeamBioSection", "Common")", {
                teamId: teamId,
                categoryIds: $('.hdnCategory').val(),
                locationIds: null,
                orderBy: "DisplayOrder"
            })
            .done(function (html) {
                $(".teamBio").hide().html(html).fadeIn(300);
                $("#teamModal").modal("show");
                history.pushState(null, null, "/team-info/" + encodeURIComponent(bioUrl));
            })
            .fail(function () {
                $(".teamBio").html("<p>Error loading bio.</p>");
            });
        }
    </script>
}



<style>
    /* Overlay covers entire screen */
    #ajaxLoaderOverlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* semi-transparent dark bg */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2000; /* above modals and everything else */
    }

        /* Loader image */
        #ajaxLoaderOverlay .loader-content img {
            height: 100px;
            width: 100px;
            animation: spin 1.2s linear infinite;
        }

    #ajaxLoaderOverlay {
        transition: opacity 0.25s ease-in-out;
    }

    /* Optional subtle rotation */
    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

