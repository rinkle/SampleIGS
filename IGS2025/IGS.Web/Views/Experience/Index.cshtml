@using Globalsetting
@inject Globalsetting.GlobalEnvironmentSetting GlobalEnvironmentSetting
@model IGS.Models.ViewModels.ExperienceViewModel

@{
    string baseUrl = GlobalEnvironmentSetting.AppSettingValue("AppSettings:baseurl");
}

@if (Model?.ExperienceList != null)
{
    <div class="projects recent-projects">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h4 class="f18">@ViewBag.HeaderAdditionalInfo</h4>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <!-- ✅ Added id="categoryFilter" -->
                    <nav id="categoryFilter" class="nav nav-filter flex-column flex-sm-row justify-content-center">
                        <a href="javascript:void(0);" class="nav-item active" data-categoryid="">All</a>
                        @if (Model?.IndustryCategory != null && Model.IndustryCategory.Count > 0)
                        {
                            foreach (var item in Model.IndustryCategory.OrderBy(x=>x.IndustryName).ToList())
                            {
                                <a href="javascript:void(0);" class="nav-item" data-categoryid="@item.Id">@item.IndustryName</a>
                            }
                        }
                    </nav>
                </div>
            </div>

            <div id="experienceContainer" class="row loadMore">
            </div>

            <div class="row mt-3">
                <div class="col-12">
                    <div class="d-flex flex-column">
                        <button id="load-more-btn" class="btn btn-load-more">Load More</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        let pageNumber = 1;
        const itemsPerPage = 8;
        let pageIds = "";
        let categoryIds = ""; // will update on click
        const orderBy = "DisplayOrder";
        const $container = $("#experienceContainer");
        const $loadMoreBtn = $("#load-more-btn");
        const $categoryFilter = $("#categoryFilter");
        let totalCount = 0;

        // ✅ Main AJAX function
        function loadExperiences(reset = false) {
            if (reset) {
                pageNumber = 1;
            }

            $loadMoreBtn.prop("disabled", true).text("Loading...");

            $.get("@Url.Action("LoadExperienceSection", "Common")", {
                categoryIds,
                pageIds,
                orderBy,
                pageNumber,
                itemsPerPage
            })
            .done(function (result) {
                if (reset) $container.empty();

                const $result = $(result);

                if (pageNumber === 1) {
                    const totalInput = $result.filter("input[name='TotalCount']");
                    if (totalInput.length) totalCount = parseInt(totalInput.val()) || 0;
                }

                if ($.trim(result).length === 0) {
                    $loadMoreBtn.fadeOut("slow");
                    return;
                }

                $container.append(result);
                pageNumber++;

                const currentCount = $container.find(".item").length;
                if (totalCount > 0 && currentCount >= totalCount) {
                    $loadMoreBtn.fadeOut("slow");
                } else {
                    $loadMoreBtn.prop("disabled", false).text("Load More").show();
                }
            })
            .fail(function () {
                $container.append("<p class='text-danger'>Error loading experiences.</p>");
                $loadMoreBtn.prop("disabled", false).text("Load More");
            });
        }

        // ✅ Initial load
        $(document).ready(function () {
            loadExperiences();
        });

        // ✅ Load more click
        $loadMoreBtn.on("click", function () {
            loadExperiences();
        });

        // ✅ Category filter click handler
        $categoryFilter.on("click", ".nav-item", function (e) {
            e.preventDefault();

            // Set active class
            $categoryFilter.find(".nav-item").removeClass("active");
            $(this).addClass("active");

            // Update categoryIds
            categoryIds = $(this).data("categoryid") || "";

            // Reset button and list
            $loadMoreBtn.show().text("Load More");
            loadExperiences(true);
        });
    </script>
}

