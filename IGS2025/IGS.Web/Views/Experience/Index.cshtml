@using Globalsetting
@inject Globalsetting.GlobalEnvironmentSetting GlobalEnvironmentSetting
@model IGS.Models.ViewModels.ExperienceViewModel

@{
    string baseUrl = GlobalEnvironmentSetting.AppSettingValue("AppSettings:baseurl");
}

@if (Model?.ExperienceList != null)
{
    <div class="projects recent-projects">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h4 class="f18">@ViewBag.HeaderAdditionalInfo </h4>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <nav class="nav nav-filter flex-column flex-sm-row justify-content-center">
                        <a href="" class="nav-item active">All</a>
                        <a href="" class="nav-item">Commercial & Industrial Services</a>
                        <a href="" class="nav-item">Consumer & Retail</a>
                        <a href="" class="nav-item">Healthcare</a>
                        <a href="" class="nav-item">Industrials & Manufacturing</a>
                        <a href="" class="nav-item">Professional Services</a>
                        <a href="" class="nav-item">Technology & Software</a>
                    </nav>
                </div>
            </div>

            <div id="experienceContainer" class="row loadMore">

                <img src='@(baseUrl + "images/loader.gif")' alt="loading..." style="height:200px;" asp-append-version="true">
            </div>

            <div class="row mt-3">
                <div class="col-12">
                    <div class="d-flex flex-column">
                        <button id="load-more-btn" class="btn btn-load-more">Load More</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        let pageNumber = 1;               
        const itemsPerPage = 8;        
        const pageIds = "";
        const categoryIds = "";
        const orderBy = "DisplayOrder";
        const $container = $("#experienceContainer");
        const $loadMoreBtn = $("#load-more-btn");
        let totalCount = 0;               // total records in DB

        function loadExperiences() {
            // show loading state
            $loadMoreBtn.prop("disabled", true).text("Loading...");
            $container.find("img[alt='loading...']").show();

            $.get("@Url.Action("LoadExperienceSection", "Common")", {
                categoryIds,
                pageIds,
                orderBy,
                pageNumber,
                itemsPerPage
            })
            .done(function (result) {
                // hide loader
                $container.find("img[alt='loading...']").hide();

                // append new results
                const $result = $(result);

                // ✅ read TotalCount safely (only on first load)
                if (pageNumber === 1) {
                    const totalInput = $result.filter("input[name='TotalCount']");
                    if (totalInput.length) {
                        totalCount = parseInt(totalInput.val()) || 0;
                    }
                }

                if ($.trim(result).length === 0) {
                    // no more data
                    $loadMoreBtn.hide();
                    return;
                }

                $container.append(result);
                pageNumber++;

                // ✅ check if all items are loaded
                const currentCount = $container.find(".item").length;
                if (totalCount > 0 && currentCount >= totalCount) {
                    $loadMoreBtn.hide();  // all data loaded
                } else {
                    $loadMoreBtn.prop("disabled", false).text("Load More");
                }
            })
            .fail(function () {
                $container.find("img[alt='loading...']").hide();
                $container.append("<p class='text-danger'>Error loading experiences.</p>");
                $loadMoreBtn.prop("disabled", false).text("Load More");
            });
        }

        // Load first page on ready
        $(document).ready(function () {
            // clear existing content (in case of reload)
            $container.html("<img src='@(baseUrl + "images/loader.gif")' alt='loading...' style='height:100px;' />");
            loadExperiences();
        });

        // Load more on button click
        $loadMoreBtn.on("click", function () {
            loadExperiences();
        });
    </script>
}

