@using Globalsetting
@inject Globalsetting.GlobalEnvironmentSetting GlobalEnvironmentSetting
@model IGS.Models.ViewModels.TeamViewModel

@{
    ViewBag.Title = "Team List";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    string baseUrl = GlobalEnvironmentSetting.AppSettingValue("AppSettings:baseurl");
}

@if (Model?.TeamList?.Count > 0)
{
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2>Team List<small></small></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <div class="row fontawesome-icon-list">
                                <div class="fa-hover col-md-12 col-sm-12 col-xs-12">
                                    <a href='@(baseUrl + "admin/team/manageteam/0")' title="Add new member"><i class="fa fa-plus-square"></i> Add new member</a>
                                </div>
                            </div>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <table id="datatable-responsive" class="table table-striped table-bordered dt-responsive nowrap" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th>Display Order</th>
                                <th>Name</th>
                                <th>Bio Image</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TeamList != null && Model.TeamList.ToList().Count > 0)
                            {
                                foreach (var item in Model.TeamList.ToList())
                                {
                                    <tr>
                                        <td>@item.DisplayOrder</td>
                                        <td>
                                            <b> @item.FirstName @item.MiddleName @item.LastName </b><i> <br />@item.TeamTitleName<br /></i>
                                        </td>
                                        <td>
                                            <img src='@(baseUrl + DbImagePath.TeamBio + item.BioImage)' onerror="imgErrorSmall(this);" style="width:100px;border:1px solid gray;" />
                                        </td>
                                        <td>
                                            <a title="Edit '@item.FirstName @item.MiddleName @item.LastName' Info" href='@(baseUrl + "admin/team/manageteam/" + item.TeamId)'><i class="fa fa-edit"></i></a>
                                            <a title="Delete '@item.FirstName @item.MiddleName @item.LastName' Info" onclick="return fnDelete(@item.TeamId,this)" href="javascript:void(0);"><i class="fa fa-trash"></i></a>
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script type="text/javascript">
        function fnDelete(id, ctrl) {
            bootbox.confirm("Are you sure to delete this team member?", function (result) {
                if (result) {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("DeleteTeam", "Team", new { area = "Admin" })",
                        contentType: "application/json; charset=utf-8",
                        data: JSON.stringify({ id: id }),
                        dataType: "json",
                        success: function (data) {
                            if (data.isSuccess) {
                                $(ctrl).closest('tr').remove();
                                bootbox.alert({
                                    message: data.message,
                                    callback: function () {
                                        location.reload();
                                    }
                                });
                            } else {
                                bootbox.alert(data.message);
                            }
                        },
                        error: function () {
                            bootbox.alert("An error occurred while deleting the team member.");
                        }
                    });
                }
            });
        }

        var table = $('#datatable-responsive').DataTable({
            "aLengthMenu": [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
            "iDisplayLength": -1
        });
    </script>
}
