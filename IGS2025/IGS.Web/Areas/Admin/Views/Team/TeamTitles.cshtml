@using Globalsetting
@inject Globalsetting.GlobalEnvironmentSetting GlobalEnvironmentSetting
@model IGS.Models.ViewModels.TeamTitleViewModel
@{
    ViewBag.Title = "Team List";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    string baseUrl = GlobalEnvironmentSetting.AppSettingValue("AppSettings:baseurl");
}
@if (Model?.TeamTitleList?.Count > 0)
{
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title">
                    <h2>Team Title<small></small></h2>
                    <ul class="nav navbar-right panel_toolbox">
                        <li>
                            <div class="row fontawesome-icon-list">
                                <div class="fa-hover col-md-12 col-sm-12 col-xs-12">
                                    <a href='@(baseUrl + "admin/team/manageteamtitle/0")' title="Add New Team title"><i class="fa fa-plus-square"></i> Add New Title</a>
                                </div>
                            </div>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">
                    <table id="datatable-responsive" class="table table-striped table-bordered dt-responsive nowrap" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th>Display Order</th>
                                <th>Title</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>
                            @foreach (var item in Model.TeamTitleList.OrderBy(x => x.DisplayOrder).ToList())
                            {
                                <tr>
                                    <td>@item.DisplayOrder</td>
                                    <td>@Html.Raw(item.Title) </td>

                                    <td>
                                        <a title="Edit '@item.Title' Info" href='@(baseUrl + "admin/team/manageteamtitle/"+item.Id)'><i class="fa fa-edit"></i></a>
                                        <a title="Delete '@item.Title' Info" onclick="return fnDelete(@item.Id,this)" href="javascript:void(0);"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section script {
    <script type="text/javascript">
        function fnDelete(id, ctrl) {
               bootbox.confirm("Are you sure you want to delete this record?", function (result) {
                if (result) {
                    $.ajax({
                        type: "POST",
                        url: '@(baseUrl + "admin/team/DeleteTeamTitle")', // Core route
                        data: { id: id },                          // no need for JSON.stringify
                        success: function (data) {
                            bootbox.alert(data.message || data.Message);
                            $(ctrl).closest("tr").remove();
                        },
                        error: function () {
                            bootbox.alert("An error occurred while deleting the record.");
                        }
                    });
                }
            });
        }
    </script>
}